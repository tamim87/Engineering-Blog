{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Update this once the project is created in the Cloudflare dashboard;
  // it must be unique within the account.
  "name": "engineering-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    // Unmatched paths fall through to Next.js's generated 404 page.
    "not_found_handling": "404-page"
  }
}
